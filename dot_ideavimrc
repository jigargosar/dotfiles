" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
let mapleader=" "
set scrolloff=5
set incsearch
set ideajoin
" Yank/delete go to the system clipboard; ideaput keeps IDE paste behavior
set clipboard=unnamed,unnamedplus,ideaput

set easymotion
" causes issues when vim is disabled.
" set which-key

" disable the timeout option
set notimeout
" increase the timeoutlen (default: 1000), don't add space around the equal sign
set timeoutlen=5000


" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
" Plug 'machakann/vim-highlightedyank'
" set highlightedyank

" Plug 'justinmk/vim-sneak'
" set sneek

let g:qs_highlight_on_keys = ['f', 'F', 't', 'T']
let g:qs_primary_color = '#ff0000'
let g:qs_secondary_color = '#ff00ff'
set quickscope

set commentary
set surround
set anyobject
set abolish
set peekaboo
set youcompleteme
set mini-ai
set youcompleteme
" let g:argtextobj_pairs="(:),{:},<:>"
" set argtextobj


set dial
" Map Ctrl+A to increment
nnoremap <C-a> :DialIncrement<cr>
" Map Ctrl+X to decrement
nnoremap <C-x> :DialDecrement<cr>

"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"" Map \r to the Reformat Code action
"map \r <Action>(ReformatCode)

"" Map <leader>d to start debug
"map <leader>d <Action>(Debug)

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)

" Don't use Ex mode, use Q for formatting.
map Q gq
" map <leader><leader> <Action>(VimFindActionIdAction)
map <leader>e :e C:/Users/jigar/.ideavimrc<CR>
map <leader>c <Action>(VCS.Commit.AI.GenerateCommitMessage)
" Cycle task status: none -> [ ] -> [.] -> [x] -> [ ]. [#] is a temp marker so the substitutions don't chain.
" Stopgap: convoluted :s chain, overwrites mark z, cursor may shift when a status is added.
" A function would be cleaner, but IdeaVim lacks setline()/setpos()/cursor() (2026).
nnoremap <Tab> mz:s/^\(\s*- \)\[x\]/\1[#]/e<bar>s/^\(\s*- \)\[\.\]/\1[x]/e<bar>s/^\(\s*- \)\[ \]/\1[.]/e<bar>s/^\(\s*- \)\[#\]/\1[ ]/e<bar>s/^\(\s*\)\(- \)\?\([^[ -]\)/\1- [ ] \3/e<CR>`z
" nnoremap j gj
" nnoremap gj j
" nnoremap j :normal! gj<CR>
" nnoremap gj :normal! j<CR>

set nomore

